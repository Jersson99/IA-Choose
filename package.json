{
  "name": "ia-choose-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node --watch-path=server/routes --watch-path=server/services --watch-path=server/controllers --watch-path=server/middleware --watch-path=server/repositories --watch-path=server/validators --watch-path=server/ml --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "train": "node --disable-warning=ExperimentalWarning scripts/trainRouter.js",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.4",
    "jsonwebtoken": "^9.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
